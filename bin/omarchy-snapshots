#!/usr/bin/env python3
"""
omarchy-snapshots: User-facing CLI tool for Omarchy Snapshots HUD.
Allows inspecting, creating, and managing system snapshots from terminal or script.
"""

import sys
import os
import json
import subprocess
import argparse

CORE_SCRIPT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "omarchy-snapshots-core")

def run_core(args_list):
    cmd = [CORE_SCRIPT] + args_list
    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    try:
        return json.loads(res.stdout)
    except Exception:
        return {"ok": False, "error": res.stderr or res.stdout}

def print_table(data):
    if not data.get("ok"):
        print(f"\033[1;31mError:\033[0m {data.get('error', 'Unknown error')}")
        return

    health = data.get("health", {})
    storage = data.get("storage", {})
    color = "\033[1;32m" if health.get("status") == "healthy" else "\033[1;33m"
    reset = "\033[0m"

    print(f"\n{color}● {health.get('label', 'Unknown')}{reset} — {health.get('reason', '')}")
    print(f"Disk: {storage.get('fsAvailHuman', '0 B')} free of {storage.get('fsSizeHuman', '0 B')} ({storage.get('usedPercent', 0)}% used) | Limine Boot Sync: {'Active' if health.get('limineSyncActive') else 'Disabled'}")

    if data.get("needsPermission"):
        print(f"\n\033[1;33mNotice:\033[0m {data.get('permissionHint', 'Permission required.')}")
        print("Run `omarchy-snapshots authorize` to grant non-root access.\n")

    for cfg in data.get("configs", []):
        snaps = cfg.get("snapshots", [])
        print(f"\n\033[1;36mSubvolume:\033[0m {cfg.get('subvolume')} ({cfg.get('name')}) — {len(snaps)} snapshots")
        if not snaps:
            if not cfg.get("readable"):
                print(f"  \033[0;31m[!] Unreadable: {cfg.get('error', 'No permission')}\033[0m")
            else:
                print("  No snapshots found.")
            continue

        print("┌──────┬───────────────┬─────────────────────┬──────────────┬───────────────────────────────┐")
        print("│   ID │ AGE           │ DATE (UTC/LOCAL)    │ CLEANUP      │ DESCRIPTION                   │")
        print("├──────┼───────────────┼─────────────────────┼──────────────┼───────────────────────────────┤")
        for s in snaps:
            pin_badge = " [📌]" if s.get("important") else ""
            pkg_badge = f" [📦{s.get('packageCount')}]" if s.get("packageCount") else ""
            desc = s.get("description", "") + pin_badge + pkg_badge
            if len(desc) > 29:
                desc = desc[:26] + "..."
            print(f"│ {s.get('id'):>4} │ {s.get('relativeAge'):<13} │ {s.get('date', ''):<19} │ {s.get('cleanup', ''):<12} │ {desc:<29} │")
        print("└──────┴───────────────┴─────────────────────┴──────────────┴───────────────────────────────┘")
    print()

def main():
    parser = argparse.ArgumentParser(description="Omarchy Snapshots CLI")
    parser.add_argument("command", nargs="?", default="list", choices=["list", "create", "delete", "pin", "unpin", "diff", "authorize", "json", "gui", "toggle", "open", "show", "restore", "packages", "restore-file", "optimize", "boot-health", "boot-sync", "boot"], help="Command to run")
    parser.add_argument("--action", choices=["create", "diff", "restore", "optimize", "boot"], help="Initial action for HUD")
    parser.add_argument("--desc", default="", help="Description for new snapshot")
    parser.add_argument("--id", type=int, help="Snapshot ID")
    parser.add_argument("--path", default="", help="File path for single-file rollback")
    parser.add_argument("--important", action="store_true", help="Pin snapshot against auto-cleanup")
    parser.add_argument("--execute", action="store_true", help="Execute optimization pruning instead of dry-run preview")
    parser.add_argument("--keep", type=int, default=3, help="Number of recent snapshots to protect (default: 3)")
    parser.add_argument("--days", type=int, default=14, help="Maximum age threshold in days before considered stale (default: 14)")
    parser.add_argument("--mock", action="store_true", help="Use mock data")

    args = parser.parse_args()

    if args.command in ["gui", "toggle", "open", "show"]:
        payload = {}
        if args.mock:
            payload["mock"] = True
        if args.action:
            payload["action"] = args.action
        if args.desc:
            payload["action"] = "create"
            payload["desc"] = args.desc
        if args.id:
            payload["id"] = args.id

        if payload:
            cmd = ["omarchy-shell", "shell", "summon", "ac.snapshots", json.dumps(payload)]
        else:
            cmd = ["omarchy-shell", "shell", "toggle", "ac.snapshots"]
        res = subprocess.run(cmd)
        subprocess.run(["hyprctl", "dispatch", "hl.dsp.focus({ window = \"title:Snapshots & Recovery\" })"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sys.exit(res.returncode)
    elif args.command in ["list", "status"]:
        core_args = ["status"]
        if args.mock:
            core_args.append("--mock")
        data = run_core(core_args)
        print_table(data)
    elif args.command == "json":
        core_args = ["status"]
        if args.mock:
            core_args.append("--mock")
        data = run_core(core_args)
        print(json.dumps(data, indent=2))
    elif args.command == "create":
        core_args = ["create", "--desc", args.desc]
        if args.important:
            core_args.append("--important")
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if res.get("ok"):
            print(f"\033[1;32m✓\033[0m {res.get('message', 'Snapshot created.')}")
        else:
            print(f"\033[1;31m✗\033[0m {res.get('error', 'Creation failed.')}")
            sys.exit(1)
    elif args.command == "restore":
        if args.id is None:
            print("Error: --id is required for restore.")
            sys.exit(1)
        core_args = ["restore", "--id", str(args.id)]
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if res.get("ok"):
            print(f"\033[1;32m✓\033[0m {res.get('message', 'System restore initiated.')}")
        else:
            print(f"\033[1;31m✗\033[0m {res.get('error', 'Restore failed.')}")
            sys.exit(1)
    elif args.command == "delete":
        if args.id is None:
            print("Error: --id is required.")
            sys.exit(1)
        core_args = ["delete", "--id", str(args.id)]
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if res.get("ok"):
            print(f"\033[1;32m✓\033[0m {res.get('message', 'Snapshot deleted.')}")
        else:
            print(f"\033[1;31m✗\033[0m {res.get('error', 'Delete failed.')}")
            sys.exit(1)
    elif args.command in ["pin", "unpin"]:
        if args.id is None:
            print("Error: --id is required.")
            sys.exit(1)
        core_args = [args.command, "--id", str(args.id)]
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if res.get("ok"):
            print(f"\033[1;32m✓\033[0m {res.get('message')}")
        else:
            print(f"\033[1;31m✗\033[0m {res.get('error')}")
            sys.exit(1)
    elif args.command == "diff":
        if args.id is None:
            print("Error: --id is required.")
            sys.exit(1)
        core_args = ["diff", "--id", str(args.id)]
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if res.get("ok"):
            summary = res.get("summary", {})
            print(f"\n\033[1;36mDiff for Snapshot #{args.id} vs Current System:\033[0m")
            print(f"Added: +{summary.get('added', 0)} | Modified: ~{summary.get('modified', 0)} | Deleted: -{summary.get('deleted', 0)}\n")
            for f in res.get("files", []):
                color = "\033[0;32m+" if f.get("status") == "added" else ("\033[0;31m-" if f.get("status") == "deleted" else "\033[0;33m~")
                print(f"  {color} {f.get('status'):<8}\033[0m {f.get('path')}")
            print()
        else:
            print(f"\033[1;31m✗\033[0m {res.get('error')}")
            sys.exit(1)
    elif args.command == "packages":
        if args.id is None:
            print("\033[1;31mError:\033[0m --id is required for packages command.")
            sys.exit(1)
        core_args = ["packages", "--id", str(args.id)]
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if not res.get("ok"):
            print(f"\033[1;31m✗\033[0m {res.get('error', 'Failed to retrieve packages')}")
            sys.exit(1)
        pkgs = res.get("packages", [])
        summary = res.get("packageSummary", "No package changes")
        crit_tag = " \033[1;33m[⚠ Critical subsystem changes included]\033[0m" if res.get("hasCriticalPackages") else ""
        print(f"\n\033[1;36mPackage Updates for Snapshot #{args.id}:\033[0m {summary} ({len(pkgs)} total){crit_tag}\n")
        if not pkgs:
            print("  No package installation, upgrade, or removal logged for this snapshot.\n")
            sys.exit(0)
        print("┌──────────────┬─────────────────────────────┬───────────────────┬──────────────────────────────────────────────┐")
        print("│ ACTION       │ PACKAGE                     │ SUBSYSTEM         │ VERSION TRANSITION                           │")
        print("├──────────────┼─────────────────────────────┼───────────────────┼──────────────────────────────────────────────┤")
        for p in pkgs:
            act = p.get("action", "")
            name = p.get("name", "")
            cat = p.get("criticalCategory") or "Normal"
            ver = p.get("version", "")
            if len(name) > 27:
                name = name[:24] + "..."
            if len(ver) > 44:
                ver = ver[:41] + "..."
            act_col = "\033[1;32m" if act in ["installed", "reinstalled"] else ("\033[1;34m" if act == "upgraded" else "\033[1;31m")
            cat_col = "\033[1;33m" if p.get("isCritical") else "\033[0m"
            print(f"│ {act_col}{act:<12}\033[0m │ {name:<27} │ {cat_col}{cat:<17}\033[0m │ {ver:<44} │")
        print("└──────────────┴─────────────────────────────┴───────────────────┴──────────────────────────────────────────────┘\n")
    elif args.command == "restore-file":
        if args.id is None:
            print("\033[1;31mError:\033[0m --id is required for restore-file command.")
            sys.exit(1)
        if not args.path:
            print("\033[1;31mError:\033[0m --path is required for restore-file command.")
            sys.exit(1)
        core_args = ["restore-file", "--id", str(args.id), "--path", args.path]
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if res.get("ok"):
            print(f"\n\033[1;32m✔ Single-File Rollback Successful!\033[0m")
            print(f"  \033[1mSnapshot:\033[0m    #{args.id}")
            print(f"  \033[1mTarget:\033[0m      {res.get('filePath')}")
            if res.get("backupPath"):
                print(f"  \033[1;36mSafety Bak:\033[0m  {res.get('backupPath')}")
            print()
            sys.exit(0)
        else:
            print(f"\033[1;31m✗\033[0m {res.get('error', 'Single-file rollback failed.')}")
            sys.exit(1)
    elif args.command == "optimize":
        core_args = ["optimize", "--keep", str(args.keep), "--days", str(args.days)]
        if args.execute:
            core_args.append("--execute")
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if not res.get("ok"):
            print(f"\033[1;31m✗\033[0m {res.get('error', 'Optimization failed')}")
            sys.exit(1)

        if res.get("executed"):
            print(f"\n\033[1;32m✔ Smart Disk Optimization Complete!\033[0m")
            print(f"  \033[1mPruned Snapshots:\033[0m  {res.get('prunedCount', 0)} ({', '.join(f'#{i}' for i in res.get('prunedIds', []))})")
            print(f"  \033[1;36mReclaimed Space:\033[0m   ~{res.get('freedHuman', '0 B')}\n")
            sys.exit(0)

        # Dry-run preview
        reclaim_str = res.get("reclaimableHuman", "0 B")
        prunable = res.get("prunableSnapshots", [])
        protected = res.get("protectedSnapshots", [])
        print(f"\n\033[1;36m🧹 Smart Btrfs Disk Optimizer & Safe Retention Guard\033[0m")
        print(f"Policy: {res.get('retentionPolicy', '')}\n")
        print(f"  📦 Total Snapshots:    {res.get('totalSnapshots', 0)}")
        print(f"  🛡️ Protected:          {res.get('protectedCount', 0)}")
        print(f"  🧹 Prunable Stale:     {res.get('prunableCount', 0)}")
        print(f"  💾 Potential Reclaim:  \033[1;32m~{reclaim_str}\033[0m\n")

        if prunable:
            print("┌──────┬───────────────┬──────────────────────────────────┬────────────────────────┐")
            print("│   ID │ AGE           │ DESCRIPTION                      │ ESTIMATED RECLAIM      │")
            print("├──────┼───────────────┼──────────────────────────────────┼────────────────────────┤")
            for p in prunable:
                desc = p.get("description", "")
                if len(desc) > 32:
                    desc = desc[:29] + "..."
                print(f"│ {p.get('id'):>4} │ {p.get('age', ''):<13} │ {desc:<32} │ ~{p.get('estimatedHuman', ''):<22} │")
            print("└──────┴───────────────┴──────────────────────────────────┴────────────────────────┘")
            print("\nTo safely prune these snapshots and reclaim space, run:")
            print(f"  \033[1;33momarchy-snapshots optimize --execute\033[0m\n")
        else:
            print("  \033[1;32m✔ Your snapshot storage is already fully optimized! No stale snapshots found.\033[0m\n")
    elif args.command in ["boot-health", "boot"]:
        core_args = ["boot-health"]
        if args.mock:
            core_args.append("--mock")
        res = run_core(core_args)
        if not res.get("ok"):
            print(f"\033[1;31m✗\033[0m {res.get('error', 'Failed to retrieve Limine boot health.')}")
            sys.exit(1)

        health_col = "\033[1;32m" if res.get("healthStatus") == "healthy" else "\033[1;33m"
        reset = "\033[0m"
        entries = res.get("entries", [])

        print(f"\n\033[1;36m󰌢 Limine Bootloader Snapshot Verification & Health\033[0m")
        print(f"{health_col}● {res.get('healthLabel', 'Limine Boot')}{reset} — {res.get('healthReason', '')}\n")
        print(f"  ESP Partition:   {res.get('espPath', '/boot')} ({res.get('espUsedHuman', '0 B')} / {res.get('espSizeHuman', '0 B')}, {res.get('espUsedPercent', 0)}% used — safety limit: {res.get('limitUsagePercent', 85)}%)")
        print(f"  Sync Daemon:     {'Active' if res.get('daemonActive') else 'Inactive'} ({res.get('daemonName', 'limine-snapper-sync')})")
        print(f"  Last Synced:     {res.get('lastSyncTimestamp', 'Unknown')} ({res.get('lastSyncRelative', '')})")
        print(f"  Boot Entries:    {len(entries)} verified bootable snapshot(s)\n")

        if entries:
            print("┌──────┬──────────────────────┬────────────────────────┬─────────────────────┬──────────────────────────┐")
            print("│   ID │ KERNEL               │ EFI PAYLOAD            │ DATE (UTC/LOCAL)    │ LIMINE BOOT STATUS       │")
            print("├──────┼──────────────────────┼────────────────────────┼─────────────────────┼──────────────────────────┤")
            for e in entries:
                sid = e.get("snapshotId", 0)
                k_ver = e.get("kernel", "linux")
                k_rel = e.get("kernelRelease", "")
                k_display = f"{k_ver} ({k_rel})" if k_rel else k_ver
                if len(k_display) > 20:
                    k_display = k_display[:17] + "..."
                efi = e.get("efiPayload", "")
                if len(efi) > 22:
                    efi = efi[:19] + "..."
                ts = e.get("timestamp", "")
                status_str = "\033[1;32m✓ Verified Bootable\033[0m" if e.get("bootReady") else "\033[1;33m⚠ Unverified\033[0m"
                print(f"│ {sid:>4} │ {k_display:<20} │ {efi:<22} │ {ts:<19} │ {status_str:<35} │")
            print("└──────┴──────────────────────┴────────────────────────┴─────────────────────┴──────────────────────────┘")
            print("\nTo manually synchronize Limine bootloader entries, run:")
            print("  \033[1;33momarchy-snapshots boot-sync\033[0m\n")
        else:
            print("  \033[1;33m⚠ No snapshot entries currently registered in Limine configuration.\033[0m\n")
        sys.exit(0)
    elif args.command == "boot-sync":
        core_args = ["boot-sync"]
        if args.mock:
            core_args.append("--mock")
        print("\033[1;36mSynchronizing Limine bootloader entries with Snapper snapshots...\033[0m")
        res = run_core(core_args)
        if res.get("ok"):
            print(f"\033[1;32m✔ {res.get('message', 'Limine bootloader entries synchronized successfully.')}\033[0m\n")
            sys.exit(0)
        else:
            print(f"\033[1;31m✗ {res.get('error', 'Limine sync failed.')}\033[0m\n")
            sys.exit(1)
    elif args.command == "authorize":
        res = run_core(["authorize"])
        if res.get("ok"):
            print(f"\033[1;32m✓\033[0m {res.get('message')}")
        else:
            print(f"\033[1;31m✗\033[0m {res.get('error')}")
        sys.exit(1)

if __name__ == "__main__":
    main()
