#!/usr/bin/env python3
"""
omarchy-snapshots-core: Backend CLI and status engine for Omarchy Snapshots HUD.
Provides fast JSON serialization of Snapper snapshots, health checks,
diff analysis, and execution runners with graceful fallback and mock modes.
"""

import sys
import os
import re
import json
import subprocess
import shutil
import argparse
import time
from datetime import datetime, timezone

def run_cmd(cmd, timeout=5):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return 1, "", str(e)

def run_privileged(cmd_args, timeout=30):
    """Run privileged command using pkexec if not root, or directly if already root."""
    if os.geteuid() == 0:
        return run_cmd(cmd_args, timeout=timeout)
    return run_cmd(["pkexec"] + cmd_args, timeout=timeout)

def format_bytes(bytes_num):
    if bytes_num is None or bytes_num < 0:
        return "0 B"
    for unit in ['B', 'KiB', 'MiB', 'GiB', 'TiB']:
        if bytes_num < 1024.0:
            return f"{bytes_num:.1f} {unit}"
        bytes_num /= 1024.0
    return f"{bytes_num:.1f} PiB"

def format_relative_time(epoch_secs):
    if not epoch_secs:
        return "Unknown"
    now = int(time.time())
    diff = max(0, now - epoch_secs)
    if diff < 60:
        return f"{diff}s ago"
    elif diff < 3600:
        mins = diff // 60
        return f"{mins}m ago"
    elif diff < 86400:
        hrs = diff // 3600
        return f"{hrs}h ago"
    elif diff < 604800:
        days = diff // 86400
        return f"{days}d ago"
    else:
        weeks = diff // 604800
        return f"{weeks}w ago"

def get_systemd_status(unit_name):
    rc, out, _ = run_cmd(["systemctl", "is-active", unit_name])
    return out == "active"

def get_disk_usage(path):
    rc, out, _ = run_cmd(["df", "-B1", "--output=pcent,size,avail", path])
    if rc != 0 or not out:
        return 0, 0, 0
    lines = out.splitlines()
    if len(lines) < 2:
        return 0, 0, 0
    parts = lines[1].split()
    try:
        pcent = int(parts[0].replace('%', ''))
        size = int(parts[1])
        avail = int(parts[2])
        return pcent, size, avail
    except Exception:
        return 0, 0, 0

def classify_package(pkg_name):
    """Classify package to determine criticality and subsystem category."""
    name = (pkg_name or "").lower()
    if name in ["linux", "linux-zen", "linux-lts", "linux-hardened", "linux-firmware", "mkinitcpio", "systemd", "systemd-libs", "btrfs-progs", "limine", "dracut"]:
        return True, "Kernel & Boot"
    if any(name.startswith(p) for p in ["nvidia", "mesa", "vulkan", "amdgpu", "intel-media"]):
        return True, "Graphics Driver"
    if name in ["hyprland", "hyprland-git", "wayland", "xorg-server", "xwayland"]:
        return True, "Display / Compositor"
    if any(name.startswith(p) for p in ["omarchy", "quickshell", "waybar", "pipewire", "wireplumber"]):
        return True, "Desktop Shell"
    return False, None

def parse_pacman_log(log_path="/var/log/pacman.log"):
    """Parse /var/log/pacman.log for package installation, upgrade, and removal events."""
    if not os.path.isfile(log_path):
        return []
    pattern = re.compile(r"^\[([0-9T:+-]+)\] \[ALPM\] (upgraded|installed|reinstalled|removed) ([^ ]+) \(([^)]+)\)")
    entries = []
    try:
        with open(log_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if "[ALPM]" not in line:
                    continue
                m = pattern.match(line)
                if not m:
                    continue
                ts, action, pkg, ver = m.groups()
                try:
                    ep = int(datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S%z").timestamp())
                except Exception:
                    continue

                old_ver = ""
                new_ver = ver
                if " -> " in ver:
                    parts = ver.split(" -> ")
                    old_ver = parts[0].strip()
                    new_ver = parts[1].strip()

                is_crit, cat = classify_package(pkg)
                entries.append({
                    "epoch": ep,
                    "action": action,
                    "name": pkg,
                    "version": ver,
                    "oldVersion": old_ver,
                    "newVersion": new_ver,
                    "isCritical": is_crit,
                    "criticalCategory": cat
                })
    except Exception:
        pass
    return entries

def correlate_packages_for_snapshots(snapshots, log_entries=None):
    """
    Correlate ALPM log entries with snapshot transaction windows.
    Takes snapshots list and attaches package details to each snapshot.
    """
    if log_entries is None:
        log_entries = parse_pacman_log()

    if not snapshots or not log_entries:
        for s in snapshots:
            s.setdefault("packageCount", 0)
            s.setdefault("hasCriticalPackages", False)
            s.setdefault("criticalPackages", [])
            s.setdefault("packages", [])
            s.setdefault("packageSummary", "No package changes")
        return snapshots

    # Sort snapshots ascending by epoch to compute intervals
    sorted_snaps = sorted(snapshots, key=lambda x: x.get("epoch", 0))
    for i, s in enumerate(sorted_snaps):
        s_epoch = s.get("epoch", 0)
        if not s_epoch:
            s["packageCount"] = 0
            s["hasCriticalPackages"] = False
            s["criticalPackages"] = []
            s["packages"] = []
            s["packageSummary"] = "No package changes"
            continue

        start_time = s_epoch - 30
        end_time = (sorted_snaps[i+1]["epoch"] - 1) if (i + 1 < len(sorted_snaps)) else (s_epoch + 1800)

        matched = [e for e in log_entries if start_time <= e["epoch"] <= end_time]
        has_crit = any(e["isCritical"] for e in matched)
        crit_names = [e["name"] for e in matched if e["isCritical"]]

        upgraded_count = sum(1 for e in matched if e["action"] == "upgraded")
        installed_count = sum(1 for e in matched if e["action"] in ["installed", "reinstalled"])
        removed_count = sum(1 for e in matched if e["action"] == "removed")

        summary_parts = []
        if upgraded_count:
            summary_parts.append(f"{upgraded_count} upgraded")
        if installed_count:
            summary_parts.append(f"{installed_count} installed")
        if removed_count:
            summary_parts.append(f"{removed_count} removed")

        summary_text = ", ".join(summary_parts) if summary_parts else ("No package changes" if not matched else f"{len(matched)} packages")

        s["packageCount"] = len(matched)
        s["hasCriticalPackages"] = has_crit
        s["criticalPackages"] = crit_names
        s["packages"] = matched
        s["packageSummary"] = summary_text

    return snapshots

