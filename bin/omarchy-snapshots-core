def get_live_status():
    limine_active = get_systemd_status("limine-snapper-sync.service")
    cleanup_active = get_systemd_status("snapper-cleanup.timer")
    snapperd_active = get_systemd_status("snapperd.service")

    # Check snapper existence
    rc, _, _ = run_cmd(["which", "snapper"])
    if rc != 0:
        return {
            "ok": False,
            "error": "Snapper is not installed on this system.",
            "readable": False,
            "needsPermission": False,
            "health": {
                "status": "error",
                "label": "Snapper Missing",
                "reason": "Snapper package not found",
                "limineSyncActive": False,
                "cleanupTimerActive": False,
                "snapperdActive": False
            },
            "storage": {"usedPercent": 0, "fsSize": 0, "fsAvail": 0, "fsSizeHuman": "0 B", "fsAvailHuman": "0 B", "snapshotCount": 0},
            "configs": []
        }

    # Query configs
    rc, configs_raw, err = run_cmd(["snapper", "--jsonout", "list-configs"])
    if rc != 0 or not configs_raw:
        # Snapper might exist but has no configs or failed
        return {
            "ok": False,
            "error": err or "Snapper reported no configurations.",
            "readable": False,
            "needsPermission": "permission" in err.lower(),
            "permissionHint": "Run 'pkexec snapper -c root set-config ALLOW_GROUPS=wheel' to enable user access." if "permission" in err.lower() else None,
            "health": {
                "status": "error",
                "label": "No Configs",
                "reason": err or "No snapper configs found",
                "limineSyncActive": limine_active,
                "cleanupTimerActive": cleanup_active,
                "snapperdActive": snapperd_active
            },
            "storage": {"usedPercent": 0, "fsSize": 0, "fsAvail": 0, "fsSizeHuman": "0 B", "fsAvailHuman": "0 B", "snapshotCount": 0},
            "configs": []
        }

    try:
        configs_json = json.loads(configs_raw)
    except Exception as e:
        configs_json = {}

    configs_list = []
    total_snapshots = 0
    newest_epoch = 0
    overall_readable = True
    any_permission_needed = False
    root_usage = (0, 0, 0)

    # In snapper json output:
    # {"configs": [{"config": "root", "subvolume": "/"}, ...]}
    configs_entries = configs_json.get("configs", []) if isinstance(configs_json, dict) else []

    for entry in configs_entries:
        cfg_name = entry.get("config") or entry.get("name")
        subvol = entry.get("subvolume", "/")
        if not cfg_name:
            continue

        pcent, size, avail = get_disk_usage(subvol)
        if cfg_name == "root" or not root_usage[1]:
            root_usage = (pcent, size, avail)

        # List snapshots for this config
        list_rc, list_out, list_err = run_cmd(["snapper", "--jsonout", "-c", cfg_name, "list"])
        cfg_readable = True
        cfg_error = None
        snapshots = []

        if list_rc != 0 or not list_out:
            cfg_readable = False
            cfg_error = list_err or "Permission denied or failed to read snapshots"
            overall_readable = False
            if "permission" in cfg_error.lower():
                any_permission_needed = True
        else:
            try:
                data = json.loads(list_out)
                # Structure: {"<config_name>": [{"number": 1, "date": "...", ...}]}
                raw_snaps = data.get(cfg_name, []) if isinstance(data, dict) else []
                for s in raw_snaps:
                    snap_id = s.get("number")
                    if snap_id == 0 or snap_id is None:
                        # 0 is the current active subvolume, not a snapshot
                        continue

                    date_str = s.get("date", "")
                    epoch = 0
                    if date_str:
                        try:
                            # format: "2026-10-07 16:40:12"
                            dt = datetime.strptime(date_str, "%Y-%m-%d %H:%M:%S")
                            epoch = int(dt.timestamp())
                        except Exception:
                            epoch = int(time.time())

                    if epoch > newest_epoch:
                        newest_epoch = epoch

                    userdata = s.get("userdata") or {}
                    cleanup_str = s.get("cleanup") or "number"
                    important = (userdata.get("important") == "yes") or (cleanup_str == "none")

                    snapshots.append({
                        "id": snap_id,
                        "type": s.get("type", "single"),
                        "description": s.get("description", "") or f"Snapshot #{snap_id}",
                        "date": date_str,
                        "epoch": epoch,
                        "relativeAge": format_relative_time(epoch),
                        "cleanup": cleanup_str,
                        "important": important,
                        "bootable": True, # On Omarchy, all root snapshots sync to Limine
                        "userdata": userdata
                    })

                # Correlate pacman packages for snapshots
                snapshots = correlate_packages_for_snapshots(snapshots)

                # Sort newest snapshot first
                snapshots.sort(key=lambda x: x["id"], reverse=True)
                total_snapshots += len(snapshots)
            except Exception as e:
                cfg_readable = False
                cfg_error = str(e)
                overall_readable = False

        configs_list.append({
            "name": cfg_name,
            "subvolume": subvol,
            "readable": cfg_readable,
            "error": cfg_error,
            "snapshots": snapshots
        })

    # Evaluate overall system health
    health_status = "healthy"
    health_label = "System Protected"
    health_reason = "Boot sync verified · Snapshots current"

    if any_permission_needed or not overall_readable:
        health_status = "warning"
        health_label = "Permission Required"
        health_reason = "Grant desktop access to view & manage snapshots"
    elif not limine_active:
        health_status = "warning"
        health_label = "Boot Sync Paused"
        health_reason = "limine-snapper-sync service is not active"
    elif total_snapshots == 0:
        health_status = "warning"
        health_label = "No Snapshots"
        health_reason = "Zero system recovery points found on disk"
    elif newest_epoch > 0 and (int(time.time()) - newest_epoch > 7 * 86400):
        health_status = "warning"
        health_label = "Snapshots Aging"
        health_reason = f"Latest snapshot is {format_relative_time(newest_epoch)}"

    return {
        "ok": True,
        "error": None,
        "readable": overall_readable,
        "needsPermission": any_permission_needed,
        "permissionHint": "Run 'pkexec snapper -c root set-config ALLOW_GROUPS=wheel' to enable passwordless desktop access." if any_permission_needed else None,
        "health": {
            "status": health_status,
            "label": health_label,
            "reason": health_reason,
            "limineSyncActive": limine_active,
            "cleanupTimerActive": cleanup_active,
            "snapperdActive": snapperd_active
        },
        "storage": {
            "usedPercent": root_usage[0],
            "fsSize": root_usage[1],
            "fsAvail": root_usage[2],
            "fsSizeHuman": format_bytes(root_usage[1]),
            "fsAvailHuman": format_bytes(root_usage[2]),
            "snapshotCount": total_snapshots
        },
        "configs": configs_list
    }

def create_snapshot(description, config="root", important=False, mock=False):
    desc = (description or "").strip() or f"Manual checkpoint {datetime.now().strftime('%Y-%m-%d %H:%M')}"
    if mock:
        return {"ok": True, "snapshotId": 20, "message": f"[Mock] Snapshot '{desc}' created successfully."}

    cmd = ["snapper", "-c", config, "create", "-c", "number", "-p", "-d", desc]
    if important:
        cmd.extend(["-u", "important=yes"])

    rc, out, err = run_cmd(cmd)
    if rc != 0 and any(w in err.lower() for w in ["permission", "must be root", "denied", "auth"]):
        # Try privileged
        rc, out, err = run_privileged(cmd)

    if rc == 0:
        snap_id = out.strip()
        msg = f"Snapshot #{snap_id} ('{desc}') created successfully." if snap_id.isdigit() else f"Snapshot '{desc}' created successfully."
        return {
            "ok": True,
            "snapshotId": int(snap_id) if snap_id.isdigit() else None,
            "message": msg
        }
    return {"ok": False, "error": err or "Failed to create snapshot."}

def restore_snapshot(snap_id, config="root", mock=False):
    """
    Restore root filesystem to a specified snapshot.
    In mock mode: returns simulated success.
    In live mode: validates that snap_id exists, and invokes recovery.
    """
    if mock:
        return {
            "ok": True,
            "snapshotId": snap_id,
            "message": f"[Mock] System restore to snapshot #{snap_id} initiated successfully. Reboot will finalize rollback."
        }

    # Verify that the snapshot exists
    st = get_live_status()
    found = False
    for cfg in st.get("configs", []):
        if cfg.get("name") == config or not config:
            for s in cfg.get("snapshots", []):
                if s.get("id") == snap_id:
                    found = True
                    break
    if not found:
        return {"ok": False, "error": f"Snapshot #{snap_id} does not exist in Snapper config '{config}'."}

    # Execute restore
    if os.path.exists("/usr/bin/limine-snapper-restore"):
        if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
            launcher = shutil.which("omarchy-launch-tui")
            if not launcher and os.environ.get("OMARCHY_PATH"):
                cand = os.path.join(os.environ["OMARCHY_PATH"], "bin", "omarchy-launch-tui")
                if os.path.exists(cand):
                    launcher = cand
            if launcher:
                cmd = [launcher, "--title=Snapshot Recovery", "sudo", "limine-snapper-restore"]
                subprocess.Popen(cmd)
                return {
                    "ok": True,
                    "snapshotId": snap_id,
                    "message": f"Recovery interface launched for snapshot #{snap_id}. Follow terminal prompts to complete."
                }
            else:
                rc, out, err = run_privileged(["limine-snapper-restore"])
        else:
            rc, out, err = run_privileged(["limine-snapper-restore"])
    else:
        rc, out, err = run_privileged(["snapper", "-c", config, "rollback", str(snap_id)])

    if rc == 0:
        return {
            "ok": True,
            "snapshotId": snap_id,
            "message": f"System restore to snapshot #{snap_id} staged successfully. Reboot to activate."
        }
    return {"ok": False, "error": err or "Failed to initiate snapshot restore."}

def delete_snapshot(snap_id, config="root", mock=False):
    if mock:
        return {"ok": True, "message": f"[Mock] Snapshot #{snap_id} deleted."}

    cmd = ["snapper", "-c", config, "delete", str(snap_id)]
    rc, out, err = run_cmd(cmd)
    if rc != 0 and ("permission" in err.lower() or "must be root" in err.lower()):
        rc, out, err = run_privileged(cmd)

    if rc == 0:
        return {"ok": True, "message": f"Snapshot #{snap_id} deleted successfully."}
    return {"ok": False, "error": err or f"Failed to delete snapshot #{snap_id}."}

def pin_snapshot(snap_id, pin=True, config="root", mock=False):
    if mock:
        state = "pinned" if pin else "unpinned"
        return {"ok": True, "message": f"[Mock] Snapshot #{snap_id} {state}."}

    # Pinning in snapper is setting userdata important=yes and cleanup=none
    val = "important=yes" if pin else "important="
    cleanup_val = "none" if pin else "number"
    cmd = ["snapper", "-c", config, "modify", "-c", cleanup_val, "-u", val, str(snap_id)]

    rc, out, err = run_cmd(cmd)
    if rc != 0 and ("permission" in err.lower() or "must be root" in err.lower()):
        rc, out, err = run_privileged(cmd)

    if rc == 0:
        action = "pinned" if pin else "unpinned"
        return {"ok": True, "message": f"Snapshot #{snap_id} successfully {action}."}
    return {"ok": False, "error": err or f"Failed to update snapshot #{snap_id}."}

def get_diff(snap_id, config="root", mock=False):
    if mock:
        return {
            "ok": True,
            "snapshotId": snap_id,
            "summary": {"added": 3, "modified": 12, "deleted": 1},
            "files": [
                {"path": "/etc/pacman.d/mirrorlist", "status": "modified"},
                {"path": "/etc/systemd/system/test.service", "status": "added"},
                {"path": "/usr/lib/modules/6.11.2-arch1-1", "status": "added"},
                {"path": "/usr/lib/modules/6.11.1-arch1-1", "status": "deleted"},
                {"path": "/etc/hypr/hyprland.conf", "status": "modified"}
            ],
            "packageCount": 6,
            "hasCriticalPackages": True,
            "criticalPackages": ["linux", "hyprland", "mesa", "omarchy"],
            "packageSummary": "5 upgraded, 1 installed",
            "packages": [
                {"name": "linux", "action": "upgraded", "version": "6.11.2-arch1-1 -> 6.11.3-arch1-1", "oldVersion": "6.11.2-arch1-1", "newVersion": "6.11.3-arch1-1", "isCritical": True, "criticalCategory": "Kernel & Boot"},
                {"name": "hyprland", "action": "upgraded", "version": "0.44.1-1 -> 0.45.0-1", "oldVersion": "0.44.1-1", "newVersion": "0.45.0-1", "isCritical": True, "criticalCategory": "Display / Compositor"},
                {"name": "omarchy", "action": "upgraded", "version": "4.0.1-1 -> 4.0.2-1", "oldVersion": "4.0.1-1", "newVersion": "4.0.2-1", "isCritical": True, "criticalCategory": "Desktop Shell"},
                {"name": "mesa", "action": "upgraded", "version": "24.2.3-1 -> 24.2.4-1", "oldVersion": "24.2.3-1", "newVersion": "24.2.4-1", "isCritical": True, "criticalCategory": "Graphics Driver"},
                {"name": "brave-bin", "action": "upgraded", "version": "1.96.59-1 -> 1.96.61-1", "oldVersion": "1.96.59-1", "newVersion": "1.96.61-1", "isCritical": False, "criticalCategory": None},
                {"name": "waybar", "action": "installed", "version": "0.11.0-1", "oldVersion": "", "newVersion": "0.11.0-1", "isCritical": True, "criticalCategory": "Desktop Shell"}
            ]
        }

    # Snapper status <id>..0 gives changed files between snapshot and current subvolume
    cmd = ["snapper", "-c", config, "status", f"{snap_id}..0"]
    rc, out, err = run_cmd(cmd)
    if rc != 0 and ("permission" in err.lower() or "must be root" in err.lower()):
        rc, out, err = run_privileged(cmd)

    if rc != 0:
        return {"ok": False, "error": err or "Failed to compute snapshot diff."}

    files = []
    added = 0
    modified = 0
    deleted = 0

    for line in out.splitlines():
        if len(line) < 3:
            continue
        # Format: "+..... /path/to/file" or "c..... /path/to/file" or "-..... /path/to/file"
        marker = line[0]
        filepath = line.strip().split()[-1] if len(line.split()) > 1 else line[7:].strip()
        status = "modified"
        if marker == '+':
            status = "added"
            added += 1
        elif marker == '-':
            status = "deleted"
            deleted += 1
        else:
            status = "modified"
            modified += 1

        files.append({"path": filepath, "status": status})

    # Attach correlated packages from snapshot status
    st = get_live_status()
    matched_pkgs = []
    pkg_summary = "No package changes"
    has_crit = False
    crit_pkgs = []
    for cfg in st.get("configs", []):
        if cfg.get("name") == config or not config:
            for s in cfg.get("snapshots", []):
                if s.get("id") == snap_id:
                    matched_pkgs = s.get("packages", [])
                    pkg_summary = s.get("packageSummary", "No package changes")
                    has_crit = s.get("hasCriticalPackages", False)
                    crit_pkgs = s.get("criticalPackages", [])
                    break

    return {
        "ok": True,
        "snapshotId": snap_id,
        "summary": {"added": added, "modified": modified, "deleted": deleted},
        "files": files[:200], # limit to top 200 changes for fast rendering
        "packageCount": len(matched_pkgs),
        "hasCriticalPackages": has_crit,
        "criticalPackages": crit_pkgs,
        "packageSummary": pkg_summary,
        "packages": matched_pkgs
    }

def restore_file(snap_id, file_path, config="root", mock=False):
    """
    Restores an individual file from a specified snapshot to the live filesystem.
    Guarantees safety by automatically creating a timestamped .bak backup of the current
    file before overwriting or removing.
    """
    if not file_path:
        return {"ok": False, "error": "file_path is required"}

    clean_path = os.path.normpath(file_path.strip())
    if not clean_path.startswith("/"):
        clean_path = "/" + clean_path

    timestamp = int(time.time())
    backup_path = f"{clean_path}.bak.{timestamp}"

    if mock:
        return {
            "ok": True,
            "snapshotId": snap_id,
            "filePath": clean_path,
            "backupPath": backup_path,
            "message": f"Successfully restored {clean_path} from snapshot #{snap_id}. Safety backup created at {backup_path}."
        }

    snapshot_dir = f"/.snapshots/{snap_id}/snapshot"
    if not os.path.isdir(snapshot_dir):
        return {"ok": False, "error": f"Snapshot #{snap_id} directory not found: {snapshot_dir}"}

    source_path = os.path.normpath(f"{snapshot_dir}{clean_path}")
    source_exists = os.path.exists(source_path) or os.path.islink(source_path)
    target_exists = os.path.exists(clean_path) or os.path.islink(clean_path)

    if not source_exists and not target_exists:
        return {"ok": False, "error": f"File {clean_path} does not exist in snapshot #{snap_id} or in live filesystem."}

    commands = []
    if target_exists:
        commands.append(f"cp -a '{clean_path}' '{backup_path}'")

    if source_exists:
        target_dir = os.path.dirname(clean_path)
        commands.append(f"mkdir -p '{target_dir}'")
        commands.append(f"cp -a '{source_path}' '{clean_path}'")
    else:
        # File was created in live system after snapshot was taken
        commands.append(f"rm -rf '{clean_path}'")

    shell_cmd = " && ".join(commands)
    rc, out, err = run_privileged(["sh", "-c", shell_cmd])

    if rc != 0:
        return {"ok": False, "error": err or f"Failed to restore {clean_path} from snapshot #{snap_id}."}

    return {
        "ok": True,
        "snapshotId": snap_id,
        "filePath": clean_path,
        "backupPath": backup_path if target_exists else None,
        "message": f"Successfully restored {clean_path} from snapshot #{snap_id}." + (f" Safety backup created at {backup_path}." if target_exists else "")
    }

def optimize_snapshots(config="root", keep=3, max_age_days=14, execute=False, mock=False):
    """
    Evaluates snapshots against safe retention guards and calculates reclaimable space.
    If execute=True, prunes eligible stale snapshots safely.
    Guards:
      - Always protects pinned (important) snapshots.
      - Always protects the newest snapshot.
      - Always protects at least `keep` most recent snapshots.
      - Protects snapshots within max_age_days.
    """
    if mock:
        prunable = [
            {"id": 16, "description": "Timeline auto-checkpoint", "age": "2w ago", "estimatedBytes": 2415919104, "estimatedHuman": "2.3 GiB"},
            {"id": 15, "description": "Pre-Update (mesa 24.2.1)", "age": "3w ago", "estimatedBytes": 2791728742, "estimatedHuman": "2.6 GiB"},
            {"id": 14, "description": "Timeline auto-checkpoint", "age": "4w ago", "estimatedBytes": 1717986918, "estimatedHuman": "1.6 GiB"}
        ]
        protected = [
            {"id": 19, "description": "Pre-Update (omarchy 4.0.2)", "reason": "Latest recovery point"},
            {"id": 18, "description": "System Baseline", "reason": "Pinned (Important)"},
            {"id": 17, "description": "Manual checkpoint", "reason": "Recent retention guard"}
        ]
        total_reclaim = sum(p["estimatedBytes"] for p in prunable)
        if execute:
            return {
                "ok": True,
                "executed": True,
                "prunedCount": len(prunable),
                "prunedIds": [p["id"] for p in prunable],
                "freedBytes": total_reclaim,
                "freedHuman": format_bytes(total_reclaim),
                "message": f"Successfully pruned {len(prunable)} stale snapshots, reclaiming ~{format_bytes(total_reclaim)}."
            }
        return {
            "ok": True,
            "executed": False,
            "totalSnapshots": len(prunable) + len(protected),
            "protectedCount": len(protected),
            "prunableCount": len(prunable),
            "reclaimableBytes": total_reclaim,
            "reclaimableHuman": format_bytes(total_reclaim),
            "prunableSnapshots": prunable,
            "protectedSnapshots": protected,
            "retentionPolicy": f"Preserves {keep} latest snapshots and all pinned checkpoints (> {max_age_days}d stale threshold)."
        }

    # Live Mode
    st = get_live_status()
    all_snaps = []
    for cfg in st.get("configs", []):
        if cfg.get("name") == config or not config:
            all_snaps = cfg.get("snapshots", [])
            break

    if not all_snaps:
        return {
            "ok": True,
            "executed": execute,
            "totalSnapshots": 0,
            "protectedCount": 0,
            "prunableCount": 0,
            "reclaimableBytes": 0,
            "reclaimableHuman": "0 B",
            "prunableSnapshots": [],
            "protectedSnapshots": [],
            "message": "No snapshots found to evaluate."
        }

    # Sort descending by ID
    sorted_snaps = sorted(all_snaps, key=lambda x: x.get("id", 0), reverse=True)
    now = int(time.time())
    max_age_secs = max_age_days * 86400

    prunable = []
    protected = []

    for i, s in enumerate(sorted_snaps):
        snap_id = s.get("id")
        desc = s.get("description", "")
        age_str = s.get("relativeAge", "")
        epoch = s.get("epoch", 0)
        is_pinned = s.get("important") is True

        if i == 0:
            protected.append({"id": snap_id, "description": desc, "reason": "Latest recovery point"})
        elif is_pinned:
            protected.append({"id": snap_id, "description": desc, "reason": "Pinned (Important)"})
        elif i < keep:
            protected.append({"id": snap_id, "description": desc, "reason": f"Recent retention guard (Top {keep})"})
        elif epoch and (now - epoch < max_age_secs):
            protected.append({"id": snap_id, "description": desc, "reason": f"Within {max_age_days}d retention window"})
        else:
            # Stale candidate
            pkg_cnt = s.get("packageCount", 0)
            est_bytes = int(1024 * 1024 * 1024 * (1.2 + min(3.0, pkg_cnt * 0.1)))
            prunable.append({
                "id": snap_id,
                "description": desc,
                "age": age_str,
                "estimatedBytes": est_bytes,
                "estimatedHuman": format_bytes(est_bytes)
            })

    total_reclaim = sum(p["estimatedBytes"] for p in prunable)

    if execute:
        pruned_ids = []
        errors = []
        for p in prunable:
            d_res = delete_snapshot(p["id"], config=config, mock=False)
            if d_res.get("ok"):
                pruned_ids.append(p["id"])
            else:
                errors.append(f"#{p['id']}: {d_res.get('error')}")

        freed_sum = sum(p["estimatedBytes"] for p in prunable if p["id"] in pruned_ids)
        if errors and not pruned_ids:
            return {"ok": False, "error": "; ".join(errors)}

        msg = f"Successfully pruned {len(pruned_ids)} stale snapshots, reclaiming ~{format_bytes(freed_sum)}."
        if errors:
            msg += f" (Note: {len(errors)} snapshots failed: {'; '.join(errors)})"

        return {
            "ok": True,
            "executed": True,
            "prunedCount": len(pruned_ids),
            "prunedIds": pruned_ids,
            "freedBytes": freed_sum,
            "freedHuman": format_bytes(freed_sum),
            "message": msg
        }

    return {
        "ok": True,
        "executed": False,
        "totalSnapshots": len(sorted_snaps),
        "protectedCount": len(protected),
        "prunableCount": len(prunable),
        "reclaimableBytes": total_reclaim,
        "reclaimableHuman": format_bytes(total_reclaim),
        "prunableSnapshots": prunable,
        "protectedSnapshots": protected,
        "retentionPolicy": f"Preserves {keep} latest snapshots and all pinned checkpoints (> {max_age_days}d stale threshold)."
    }

def authorize_access(config="root"):
    """Grants the wheel group permissions in snapper config and /.snapshots permissions."""
    # 1. snapper set-config ALLOW_GROUPS="wheel"
    cmd1 = ["snapper", "-c", config, "set-config", "ALLOW_GROUPS=wheel"]
    rc1, out1, err1 = run_privileged(cmd1)

    # 2. chmod a+rx /.snapshots
    cmd2 = ["chmod", "a+rx", "/.snapshots"]
    rc2, out2, err2 = run_privileged(cmd2)

    if rc1 == 0 and rc2 == 0:
        return {"ok": True, "message": "Permissions granted! You can now view and create snapshots passwordlessly."}
    return {"ok": False, "error": f"{err1} {err2}".strip()}

def main():
    parser = argparse.ArgumentParser(description="Omarchy Snapshots Backend Core")
    parser.add_argument("command", choices=["status", "create", "delete", "pin", "unpin", "diff", "authorize", "restore", "packages", "restore-file", "optimize"], help="Action to execute")
    parser.add_argument("--mock", action="store_true", help="Output mock data for testing or preview")
    parser.add_argument("--config", default="root", help="Snapper config name (default: root)")
    parser.add_argument("--desc", default="", help="Description for snapshot creation")
    parser.add_argument("--id", type=int, help="Snapshot ID for operations")
    parser.add_argument("--path", default="", help="File path for single-file rollback")
    parser.add_argument("--important", action="store_true", help="Mark snapshot as important (pinned)")
    parser.add_argument("--execute", action="store_true", help="Execute optimization pruning instead of dry-run preview")
    parser.add_argument("--keep", type=int, default=3, help="Number of recent snapshots to protect (default: 3)")
    parser.add_argument("--days", type=int, default=14, help="Maximum age threshold in days before considered stale (default: 14)")

    args = parser.parse_args()

    if args.command == "status":
        res = get_mock_status() if args.mock else get_live_status()
        print(json.dumps(res, indent=2))
    elif args.command == "create":
        desc = args.desc.strip() or f"Manual checkpoint {datetime.now().strftime('%Y-%m-%d %H:%M')}"
        res = create_snapshot(desc, config=args.config, important=args.important, mock=args.mock)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)
    elif args.command == "restore":
        if args.id is None:
            print(json.dumps({"ok": False, "error": "--id is required for restore"}))
            sys.exit(1)
        res = restore_snapshot(args.id, config=args.config, mock=args.mock)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)
    elif args.command == "delete":
        if args.id is None:
            print(json.dumps({"ok": False, "error": "--id is required for delete"}))
            sys.exit(1)
        res = delete_snapshot(args.id, config=args.config, mock=args.mock)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)
    elif args.command in ["pin", "unpin"]:
        if args.id is None:
            print(json.dumps({"ok": False, "error": "--id is required"}))
            sys.exit(1)
        res = pin_snapshot(args.id, pin=(args.command == "pin"), config=args.config, mock=args.mock)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)
    elif args.command == "diff":
        if args.id is None:
            print(json.dumps({"ok": False, "error": "--id is required for diff"}))
            sys.exit(1)
        res = get_diff(args.id, config=args.config, mock=args.mock)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)
    elif args.command == "packages":
        if args.id is None:
            print(json.dumps({"ok": False, "error": "--id is required for packages"}))
            sys.exit(1)
        st = get_mock_status() if args.mock else get_live_status()
        found = None
        for cfg in st.get("configs", []):
            if cfg.get("name") == args.config or not args.config:
                for s in cfg.get("snapshots", []):
                    if s.get("id") == args.id:
                        found = s
                        break
        if not found:
            print(json.dumps({"ok": False, "error": f"Snapshot #{args.id} not found."}))
            sys.exit(1)
        print(json.dumps({
            "ok": True,
            "snapshotId": args.id,
            "packageCount": found.get("packageCount", 0),
            "hasCriticalPackages": found.get("hasCriticalPackages", False),
            "criticalPackages": found.get("criticalPackages", []),
            "packageSummary": found.get("packageSummary", ""),
            "packages": found.get("packages", [])
        }, indent=2))
        sys.exit(0)
    elif args.command == "restore-file":
        if args.id is None:
            print(json.dumps({"ok": False, "error": "--id is required for restore-file"}))
            sys.exit(1)
        if not args.path:
            print(json.dumps({"ok": False, "error": "--path is required for restore-file"}))
            sys.exit(1)
        res = restore_file(args.id, args.path, config=args.config, mock=args.mock)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)
    elif args.command == "optimize":
        res = optimize_snapshots(config=args.config, keep=args.keep, max_age_days=args.days, execute=args.execute, mock=args.mock)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)
    elif args.command == "authorize":
        res = authorize_access(config=args.config)
        print(json.dumps(res, indent=2))
        sys.exit(0 if res.get("ok") else 1)

if __name__ == "__main__":
    main()
