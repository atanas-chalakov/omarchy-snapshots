[Desktop Entry]
Name=Snapshots & Recovery
GenericName=Btrfs & Snapper System Restore HUD
Comment=Instant Btrfs snapshot management, visual diffs, and bootloader rollback HUD for Omarchy
Exec=omarchy-snapshots gui
Icon=omarchy-snapshots
Terminal=false
Type=Application
Categories=System;
Keywords=snaps;snapshot;snapshots;snapper;btrfs;backup;restore;rollback;recovery;limine;grub;boot;omarchy;
StartupNotify=true
Actions=Create;Diff;Mock;

[Desktop Action Create]
Name=New Checkpoint
Exec=omarchy-snapshots gui --action create

[Desktop Action Diff]
Name=Recent Changes Diff
Exec=omarchy-snapshots gui --action diff

[Desktop Action Mock]
Name=Open Demo Preview
Exec=omarchy-snapshots gui --mock
